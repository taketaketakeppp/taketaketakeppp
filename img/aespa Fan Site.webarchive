* {
  box-sizing: border-box;
}

/* ==================================
   GLOBAL SETUP
================================== */
html, body {
  overflow-x: hidden;
  width: 100%;
  margin: 0;
  padding: 0;
}

.logo {
  width: 50%;
}

/* ==================================
   HERO
================================== */
.hero {
  position: relative;
  width: 100%;
  height: 100dvh;
  overflow: hidden;
  background: #000;
}

.heroSwiper {
  width: 100%;
  height: 100%;
}

.heroSwiper .swiper-slide {
  width: 100%;
  height: 100%;
}

.heroSwiper .swiper-slide img {
  width: 100%;
  height: 100%;
  object-fit: cover;
  object-position: center;
}

/* ã‚ªãƒ¼ãƒãƒ¼ãƒ¬ã‚¤ */
.hero-overlay {
  position: absolute;
  inset: 0;
  background: linear-gradient(to bottom, rgba(5,5,5,0.2), rgba(5,5,5,0.8));
  z-index: 2;
  pointer-events: none;
}

/* ãƒ†ã‚­ã‚¹ãƒˆ */
.hero-content {
  position: absolute;
  bottom: 10%;
  left: 4%;
  z-index: 3;
  max-width: 800px;
}

.hero-sub {
  font-size: 14px;
  letter-spacing: 4px;
  color: #9b78ff;
  font-weight: 700;
  margin-bottom: 10px;
}

.hero h1 {
  font-size: 110px;
  font-weight: 900;
  line-height: 0.9;
  color: #fff;
}

.hero h2 {
  font-size: 32px;
  font-weight: 300;
  letter-spacing: 12px;
  color: #fff;
  opacity: 0.9;
}

.hero p {
  font-size: 16px;
  line-height: 1.8;
  color: #e0e0e0;
}
/* å…¨ä½“ */
.profile-block {
  width: 92%;
  max-width: 1200px;
  margin: 120px auto;
}

/* å¤§ãã„ãƒ¡ã‚¤ãƒ³ç”»åƒ */
.profile-main img {
  width: 100%;
  border-radius: 12px;
  object-fit: cover;
  display: block;
  margin-bottom: 40px;
}

/* 4äººã®å°ã•ã„ç”»åƒ */
.profile-members {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 20px;
}

.profile-members .member img {
  width: 100%;
  aspect-ratio: 1 / 1.2;
  object-fit: cover;
  border-radius: 12px;
  border: 1px solid rgba(255,255,255,0.15);
  transition: .3s ease;
}

.profile-members .member img:hover {
  transform: scale(1.05);
}

/* ===== 768pxä»¥ä¸‹ ===== */
@media (max-width: 768px) {
  .profile-members {
    grid-template-columns: repeat(2, 1fr);
    gap: 16px;
  }
}

/* ===== 480pxä»¥ä¸‹ ===== */
@media (max-width: 480px) {
  .profile-members {
    grid-template-columns: 1fr;
  }
}

/* Swiper UI */
.swiper-button-next,
.swiper-button-prev {
  color: #9b78ff !important;
}

.swiper-pagination-bullet {
  background: #fff !important;
  opacity: 0.4;
}

.swiper-pagination-bullet-active {
  background: #9b78ff !important;
}

/* ==================================
   PROJECTS
================================== */
.projects {
  display: flex;
  gap: 40px;
  width: 92%;
  margin: 140px auto;
}

.project-card {
  flex: 1;
  background: rgba(20,20,25,0.8);
  border: 1px solid rgba(155,120,255,0.15);
}

.project-card img {
  width: 100%;
  height: 320px;
  object-fit: cover;
}

.project-info {
  padding: 40px;
}

.project-title {
  font-size: 36px;
  font-weight: 900;
}

/* ==================================
   CONTENTS
================================== */
.service-list {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 24px;
}

.service-item {
  padding: 35px 40px;
  border-left: 4px solid #9b78ff;
}

/* ==================================
   ABOUTï¼ˆä¿®æ­£ç‰ˆï¼‰
================================== */
.about-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 80px;
  align-items: center;
}

/* 2Ã—2 ãƒ¡ãƒ³ãƒãƒ¼ç”»åƒã‚°ãƒªãƒƒãƒ‰ */
.about-images {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 16px;
  justify-items: center;
  align-items: center;
}

.about-images .img-box {
  width: 100%;
  aspect-ratio: 1 / 1;
  overflow: hidden;
  border-radius: 16px;
  border: 1px solid rgba(155,120,255,.2);
  box-shadow: 0 10px 30px rgba(0,0,0,.35);
  transition: transform .4s ease;
}

.about-images .img-box img {
  width: 100%;
  height: 100%;
  object-fit: cover;
  display: block;
}

.about-images .img-box:hover {
  transform: scale(1.05);
}

.about-grid .section-title {
  font-size: 52px;
  line-height: .95;
}

.about-grid .section-text {
  margin-top: 30px;
  max-width: 500px;
}

/* ==================================
   BUTTON
================================== */
.hero-btn-1 {
  padding: 18px 45px;
  border: 1px solid #9b78ff;
  color: #9b78ff;
  display: inline-block;
  text-decoration: none;
  cursor: pointer;
}

.hero-btn-1:hover {
  background: #9b78ff;
  color: #000;
}

/* ==================================
   RESPONSIVE
================================== */
@media (min-width: 1024px) {
  .hamburger {
    display: none;
  }
}

/* ===== 1024px ===== */
@media (max-width: 1024px) {
  .hero h1 { font-size: 80px; }
  .hero h2 { font-size: 24px; }

  .projects { gap: 20px; }
  .project-title { font-size: 28px; }

  .about-grid { gap: 40px; }
}

/* ===== 768px ===== */
@media (max-width: 768px) {
  .hamburger {
    display: flex;
    flex-direction: column;
    cursor: pointer;
  }

  .hero {
    height: auto;
  }

  .heroSwiper {
    height: 60vh;
  }

  .hero-content {
    position: relative;
    bottom: auto;
    left: auto;
    padding: 30px 5% 10px;
    background: #050505;
  }

  .hero h1 {
    font-size: 42px;
  }

  .hero h2 {
    font-size: 15px;
    letter-spacing: 3px;
  }

  .hero p {
    font-size: 14px;
  }

  /* PROJECTS */
  .projects {
    flex-direction: column;
    gap: 30px;
    margin: 60px auto;
  }

  .project-card img {
    height: 200px;
  }

  /* CONTENTS */
  .service-list {
    grid-template-columns: 1fr;
  }

  /* ABOUT */
  .about-grid {
    grid-template-columns: 1fr;
  }

  .about-images {
    grid-template-columns: repeat(2, 1fr);
    gap: 12px;
  }

  .hero-btn-1 {
    width: 100%;
    text-align: center;
  }

  /* Swiper arrowséžè¡¨ç¤º */
  .swiper-button-next,
  .swiper-button-prev {
    display: none !important;
  }
}

/* ===== 480px ===== */
@media (max-width: 480px) {
  .heroSwiper {
    height: 50vh;
  }

  .hero h1 {
    font-size: 34px;
  }

  .hero h2 {
    font-size: 13px;
  }

  .project-title {
    font-size: 22px;
  }

  /* ABOUTï¼š1åˆ—ã«å¤‰æ›´ */
  .about-images {
    grid-template-columns: 1fr;
  }
}
