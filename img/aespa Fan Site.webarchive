€	␀€␀€€€€€Ó$%'(WNS.base[NS.relative€␀€€_-file:///Users/user/Desktop/aespa/js/script.jsÒ+,-.Z$classnameX$classesUNSURL¢-/XNSObject#AÇæš´Á,k_text/javascript;#ïÿÿÿÿÿÿÒ+,56]NSURLResponse¢7/]NSURLResponse␀␀␀␀$␀)␀2␀7␀I␀L␀b␀d␀p␀v␀␀”␀¶␀¹␀Û␀ýADfˆ‹‘“•—™›Ÿ¡¨°¼¾ÀÂò÷&8;DIWZ␀␀␀␀␀␀␀␀␀␀␀␀␀8␀␀␀␀␀␀␀␀␀␀␀␀␀␀hÔtuqv_2file:///Users/user/Desktop/aespa/js/discography.jsOFdocument.addEventListener("DOMContentLoaded", () => {

  const buttons = document.querySelectorAll(".filter button");
  const items = document.querySelectorAll(".item");

  let activeFilter = "all";

  // =========================
  // ãƒ•ã‚£ãƒ«ã‚¿ãƒ¼å‡¦ç†
  // =========================
  function filterItems(filter) {

    items.forEach((item, index) => {

      const type = item.dataset.category;

      const shouldShow =
        filter === "all" || filter === type;

      if (shouldShow) {

        item.style.display = "block";

        // ã‚¢ãƒ‹ãƒ¡ãƒ¼ã‚·ãƒ§ãƒ³ï¼ˆé…å»¶å‡ºç¾ï¼‰
        item.style.opacity = "0";
        item.style.transform = "translateY(20px)";

        setTimeout(() => {
          item.style.transition = "0.5s ease";
          item.style.opacity = "1";
          item.style.transform = "translateY(0)";
        }, index * 40);

      } else {

        item.style.display = "none";

      }

    });

  }

  // =========================
  // ãƒœã‚¿ãƒ³ã‚¤ãƒ™ãƒ³ãƒˆ
  // =========================
  buttons.forEach(btn => {

    btn.addEventListener("click", () => {

      // activeåˆ‡æ›¿
      buttons.forEach(b => b.classList.remove("active"));
      btn.classList.add("active");

      activeFilter = btn.dataset.filter;

      filterItems(activeFilter);

    });

  });

  // åˆæœŸè¡¨ç¤º
  filterItems("all");

});Oýbplist00Ô
